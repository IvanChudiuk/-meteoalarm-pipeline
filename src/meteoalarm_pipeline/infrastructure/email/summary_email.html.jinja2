<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>MeteoAlarm summary</title>
    <style>
      body { font-family: Arial, sans-serif; color: #1f2937; background: #f8fafc; padding: 20px; }
      .card { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 22px; max-width: 1100px; margin: 0 auto; }
      h2 { margin: 0 0 8px 0; color: #0f172a; font-size: 28px; }
      .meta { color: #475569; font-size: 12px; margin-bottom: 16px; }
      table { border-collapse: collapse; width: 100%; margin-top: 12px; background: white; font-size: 12px; }
      th, td { border: 1px solid #dbe2ea; padding: 8px 10px; text-align: center; vertical-align: middle; }
      th { background: #eef2ff; color: #1e293b; font-weight: 700; font-size: 12px; }
      tr:nth-child(even) { background: #f8fafc; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 999px; font-weight: 700; font-size: 11px; }
      .red { background: #fee2e2; color: #991b1b; }
      .orange { background: #fed7aa; color: #9a5b00; }
      .yellow { background: #fef3c7; color: #92400e; }
      .green { background: #dcfce7; color: #166534; }
    </style>
  </head>
  <body>
    <div class="card">
      <h2>MeteoAlarm alert summary — {{ execution_date }}</h2>
      <div class="meta">Generated at: {{ execution_date }}</div>

      {% if rows %}
      <table>
        <thead>
          <tr>
            <th>alert_color</th>
            <th>alert_type</th>
            <th>country_name</th>
            <th>zone_name</th>
            <th>alert_start</th>
            <th>alert_expires</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          <tr>
            <td>
              <span class="badge {% if row.alert_color == 'Red' %}red{% elif row.alert_color == 'Orange' %}orange{% elif row.alert_color == 'Yellow' %}yellow{% else %}green{% endif %}">
                {{ row.alert_color }}
              </span>
            </td>
            <td>{{ row.alert_type }}</td>
            <td>{{ row.country_name }}</td>
            <td>{{ row.zone_name }}</td>
            <td>{{ row.alert_start }}</td>
            <td>{{ row.alert_expires }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>No active alerts found for this execution.</p>
      {% endif %}
    </div>
  </body>
</html>
